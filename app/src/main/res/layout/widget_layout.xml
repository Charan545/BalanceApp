<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp"
    android:background="#AA000000"> <!-- Semi-transparent background for readability -->

    <TextView
        android:id="@+id/widgetTotalTime"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="18sp"
        android:textColor="#FFFFFF"
        android:text="Total Screen Time: --" />

    <TextView
        android:id="@+id/widgetAppUsageDetails"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/widgetTotalTime"
        android:textSize="14sp"
        android:textColor="#FFFFFF"
        android:paddingTop="8dp"
        android:text="App usage details" />

</RelativeLayout>
